# Copy to .env.local and fill in. Never commit .env.local.

# --------------------------------------------------------------- Supabase
# Project settings -> API. The publishable/anon key is public by design;
# the secret key is server-only and must never reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ------------------------------------------------------------------ site
# The address this deployment answers on. Used for the links Supabase
# emails (sign-up confirmation, password reset), so it must also be on the
# Supabase redirect allowlist. https://www.propitz.com in production.
NEXT_PUBLIC_SITE_URL=

# ----------------------------------------------------------------- email
# Resend (https://resend.com) sends the "someone got in touch" mails for
# enquiries, seller callbacks and job applications. Without a key nothing
# is sent and nothing breaks — submissions are still saved to Supabase.
RESEND_API_KEY=
# Who receives them. Defaults to enquire@propitz.com.
NOTIFY_EMAIL=
# Who they come from. The domain must be verified in Resend, or Resend
# refuses the send. Defaults to "PropITZ <noreply@propitz.com>".
EMAIL_FROM=

# ------------------------------------------------------------ spam check
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile) checks
# that a person, not a script, filled the form. Add a site for
# www.propitz.com, widget type Managed, and paste both keys here. Without
# them the check is skipped and no widget is shown — the forms still work.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Salt for the hashed addresses the rate limiter stores. Any long random
# string; changing it just resets the counters. Optional.
RATE_LIMIT_SALT=

# ---------------------------------------------------------- retention
# Vercel Cron calls /api/cron/cleanup daily to delete applications past
# the 24-month retention period and any abandoned CV upload. Any long
# random string; the route refuses to run without it.
CRON_SECRET=
